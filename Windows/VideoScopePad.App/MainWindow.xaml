<Window x:Class="VideoScopePad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoScopePad.App"
        Title="VideoScopePad · Windows 版（实时监视）"
        Height="900" Width="1500"
        MinHeight="400" MinWidth="700"
        Background="#0E1014"
        WindowStartupLocation="CenterScreen">
  <!--
    界面故意做得薄：一栏源选择 + 一张实时位图 + 一行状态。
    刻度栏（IRE 数字 / 色标框）以后按 iPad 版的做法做成覆盖层 —— 与 GPU 出来的
    示波器纹理共用同一份 ScopeLayout，因此天然对齐。
  -->
  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#141820" Padding="10,6">
      <!-- 布局与格内容一行（控件在代码里建：选项列表只写一处，7 个下拉共用） -->
      <WrapPanel x:Name="LayoutRow" VerticalAlignment="Center"/>
    </Border>

    <Border DockPanel.Dock="Top" Background="#171A20" Padding="10,8">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock Text="信号源" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <!-- 选项在代码里按**实时设备列表**建（不再写死三档）：多张卡/多台摄像头都列出来 -->
          <ComboBox x:Name="SourceBox" Width="230"
                    SelectionChanged="OnSourceChanged"
                    Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440"/>

          <Button x:Name="RefreshDevicesButton" Content="刷新设备" Margin="6,0,0,0" Padding="10,4"
                  Click="OnRefreshDevices" Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440"/>
          <TextBlock x:Name="DeviceStateText" Foreground="#E8C46A" VerticalAlignment="Center"
                     Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>

          <Button x:Name="SaveButton" Content="存一帧 PNG" Margin="12,0,0,0" Padding="12,4"
                  Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440"
                  Click="OnSaveClicked"/>

          <Button x:Name="FreezeButton" Content="冻结参考" Margin="8,0,0,0" Padding="12,4"
                  Background="#2A2418" Foreground="#F0C86A" BorderBrush="#4A3C1E"
                  ToolTip="把这一刻的示波器图形冻成琥珀色参考层，实时轨迹照常刷新"
                  Click="OnFreezeClicked"/>
          <Button x:Name="ClearReferenceButton" Content="清除参考" Margin="6,0,0,0" Padding="12,4"
                  Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440"
                  Click="OnClearReferenceClicked"/>

          <TextBlock Text="参考层" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="12,0,6,0"/>
          <Slider x:Name="OpacitySlider" Width="100" Minimum="0.1" Maximum="1.0" Value="0.55"
                  VerticalAlignment="Center" ValueChanged="OnOpacityChanged"
                  ToolTip="参考层不透明度（实时轨迹恒为 100%）"/>

          <CheckBox x:Name="ZebraBox" Content="超白斑马" Margin="14,0,0,0"
                    Checked="OnZebraChanged" Unchecked="OnZebraChanged"
                    Foreground="#E6EAF0"/>
          <ComboBox x:Name="ZebraThresholdBox" Width="92" Margin="6,0,0,0"
                    SelectionChanged="OnZebraChanged"
                    Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440">
            <ComboBoxItem Content="70 IRE"/>
            <ComboBoxItem Content="75 IRE"/>
            <ComboBoxItem Content="90 IRE"/>
            <ComboBoxItem Content="95 IRE"/>
            <ComboBoxItem Content="100 IRE"/>
          </ComboBox>
          <CheckBox x:Name="ZebraBlackBox" Content="黑切割" Margin="10,0,0,0"
                    Checked="OnZebraChanged" Unchecked="OnZebraChanged"
                    Foreground="#E6EAF0"/>
          <CheckBox x:Name="AlarmBox" Content="超标报警" IsChecked="True" Margin="12,0,0,0"
                    Checked="OnAlarmChanged" Unchecked="OnAlarmChanged"
                    Foreground="#E6EAF0"/>
          <ComboBox x:Name="AlarmThresholdBox" Width="96" Margin="6,0,0,0"
                    SelectionChanged="OnAlarmChanged"
                    Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440">
            <ComboBoxItem Content="门槛 1 次"/>
            <ComboBoxItem Content="门槛 2 次"/>
            <ComboBoxItem Content="门槛 3 次"/>
          </ComboBox>

          <CheckBox x:Name="GraticuleBox" Content="刻度" IsChecked="True" Margin="14,0,0,0"
                    Foreground="#E6EAF0" VerticalAlignment="Center"
                    Checked="OnGraticuleToggled" Unchecked="OnGraticuleToggled"/>

          <TextBlock Text="单位" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="14,0,6,0"/>
          <ComboBox x:Name="UnitBox" Width="96" SelectedIndex="0"
                    SelectionChanged="OnUnitChanged"
                    Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440">
            <ComboBoxItem Content="IRE"/>
            <ComboBoxItem Content="mV（等效）"/>
            <ComboBoxItem Content="%"/>
          </ComboBox>

          <CheckBox x:Name="CsvLogBox" Content="记录读数" Margin="12,0,0,0"
                    Checked="OnCsvLogChanged" Unchecked="OnCsvLogChanged"
                    Foreground="#E6EAF0"/>
          <Button x:Name="ExportCsvButton" Content="导出读数 CSV" Margin="6,0,0,0" Padding="10,4"
                  Click="OnExportCsv" Background="#22262E" Foreground="#E6EAF0" BorderBrush="#2E3440"/>
          <TextBlock x:Name="SaveHint" Foreground="#6C7686" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Foreground="#9AA4B2"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#12151A" Padding="10,6">
      <StackPanel>
        <Border x:Name="AlarmBar" Background="#3A1214" BorderBrush="#FF3B30" BorderThickness="1"
                Padding="6,2" Margin="0,0,0,3" Visibility="Collapsed">
          <TextBlock x:Name="AlarmText" Foreground="#FF6B61" FontFamily="Consolas"
                     FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
        </Border>
        <TextBlock x:Name="MeasurementText" Foreground="#D8DEE8" FontFamily="Consolas"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="DetailText" Foreground="#7C8797" TextTrimming="CharacterEllipsis"
                   Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <Border x:Name="AlarmFrame" BorderBrush="#FF3B30" BorderThickness="0">
      <Grid Background="#0B0D10">
      <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <!-- 刻度层：自绘元素，铺在实时位图之上（与画面同一份 ScopeLayout，所以严格对齐） -->
      <local:GraticuleElement x:Name="Graticule"/>
      <TextBlock x:Name="MessageText" Foreground="#E0B341" Margin="16"
                 VerticalAlignment="Top" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"/>
      </Grid>
    </Border>

  </DockPanel>
</Window>
