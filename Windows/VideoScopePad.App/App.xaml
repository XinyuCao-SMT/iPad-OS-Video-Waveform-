<Application x:Class="VideoScopePad.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    启动项在代码里（App.xaml.cs）：带 snapshot 参数时走无窗口自检，
    否则开主窗口。所以这里不设 StartupUri。
  -->
  <Application.Resources>
    <!--
      深色主题：下拉框要设**两处**样式，少一处就会出现"看不见"的问题。
      🔴 坑 1（已修）：只给 ComboBox 设 Background/Foreground 时，弹出列表里的 ComboBoxItem
         仍是系统默认浅底，而前景继承了我们设的浅色 → 白底白字，看着像"一列灰蒙蒙、禁用、点了没反应"。
      🔴 坑 2（本轮修）：只修了 ComboBoxItem 还不够 —— **合上时的选中框**用的是 ComboBox 自己的
         默认模板（浅底），而 Foreground 是我们设的浅色 → 当前选项看不见（用户反馈的就是这个）。
         所以下面给 ComboBox 本身也换了一套深色模板，并把选中框文字颜色用
         TextElement.Foreground 直接钉死（不依赖 Foreground 的继承）。
    -->
    <SolidColorBrush x:Key="VspPanelBrush" Color="#22262E"/>
    <SolidColorBrush x:Key="VspPanelHoverBrush" Color="#2E3644"/>
    <SolidColorBrush x:Key="VspPanelSelectedBrush" Color="#3A4A5A"/>
    <SolidColorBrush x:Key="VspTextBrush" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="VspBorderBrush" Color="#39414F"/>

    <!-- 下拉列表项 -->
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Background" Value="{StaticResource VspPanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource VspTextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter TextElement.Foreground="{StaticResource VspTextBrush}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource VspPanelHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource VspPanelSelectedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 下拉框本体（含合上时的选中框 —— 这一处以前缺了，导致"看不到当前选项"） -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource VspTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource VspPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource VspBorderBrush}"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{StaticResource VspPanelBrush}"
                            BorderBrush="{StaticResource VspBorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Data="M 0 0 L 4 4 L 8 0"
                            Stroke="{StaticResource VspTextBrush}" StrokeThickness="1.6"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <!-- 合上时显示的当前选项：文字颜色直接钉在这里 -->
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                TextElement.Foreground="{StaticResource VspTextBrush}"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     PopupAnimation="Slide">
                <Border Background="{StaticResource VspPanelBrush}"
                        BorderBrush="{StaticResource VspBorderBrush}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
